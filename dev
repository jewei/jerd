#!/bin/sh
# Runs the jerd-dev tool from Tools/. SwiftPM builds it in release mode into Tools/.build/dev and
# rebuilds it only when the Tools sources change. The tool has its own build folder, so that the
# debug build of `./dev test --tools` does not make the next `./dev` call rebuild the tool.
# Run `./dev help` for the commands.
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
scratch="$root/Tools/.build/dev"
tool="$scratch/release/jerd-dev"

developer_dir=$(xcode-select --print-path 2>/dev/null || true)
if [ -z "$developer_dir" ] || [ ! -x "$developer_dir/usr/bin/xcodebuild" ]; then
	xcode_version=$(cat "$root/.xcode-version" 2>/dev/null || echo "16 or later")
	echo "error: Xcode is missing or not selected. Install Xcode $xcode_version from" >&2
	echo "https://developer.apple.com/download/applications/, then run:" >&2
	echo "  sudo xcode-select --switch /Applications/Xcode.app" >&2
	exit 3
fi

if [ ! -x "$tool" ]; then
	echo "Building the jerd-dev tool. The first build takes about one minute." >&2
fi
if ! /usr/bin/xcrun swift build --package-path "$root/Tools" --scratch-path "$scratch" \
	--configuration release --product jerd-dev --quiet >&2; then
	echo "error: Could not build the jerd-dev tool. See the compiler output above." >&2
	exit 1
fi

cd "$root"
exec "$tool" "$@"
